{
  "format": "sfx-lab-project",
  "version": 1,
  "project": {
    "name": "Fixture panel",
    "tempo": 100,
    "sceneCount": 2,
    "tracks": [
      {
        "id": "track_fixture",
        "name": "Beep",
        "volume": 0.5,
        "patch": {
          "nodes": [
            { "id": "n1", "type": "note", "x": 10, "y": 20, "params": {} },
            { "id": "n2", "type": "oscillator", "x": 200, "y": 20, "params": { "waveform": 2, "frequency": 220, "detune": 0 } },
            { "id": "n3", "type": "filter", "x": 400, "y": 20, "params": { "mode": 0, "cutoff": 1500, "resonance": 2 } },
            { "id": "n4", "type": "output", "x": 600, "y": 20, "params": {} }
          ],
          "connections": [
            { "id": "w1", "from": { "node": "n1", "port": "frequency" }, "to": { "node": "n2", "port": "freq" } },
            { "id": "w2", "from": { "node": "n2", "port": "out" }, "to": { "node": "n3", "port": "in" } },
            { "id": "w3", "from": { "node": "n3", "port": "out" }, "to": { "node": "n4", "port": "in" } }
          ],
          "panel": [
            { "id": "c1", "kind": "xy", "label": "Tone", "bind": { "node": "n3", "param": "cutoff" }, "bindY": { "node": "n3", "param": "resonance" }, "size": "L" },
            { "id": "c2", "kind": "selector", "label": "Wave", "bind": { "node": "n2", "param": "waveform" }, "size": "S" },
            { "id": "c3", "kind": "slider", "label": "Pitch", "bind": { "node": "n2", "param": "frequency" }, "size": "M", "orientation": "horizontal" },
            { "id": "c4", "kind": "knob", "label": "Detune", "bind": { "node": "n2", "param": "detune" }, "size": "S" }
          ]
        },
        "clips": [null, null]
      }
    ]
  }
}
