{
  "name": "sfx-lab-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && playwright test --project='smoke-*'",
    "test:smoke:group": "npm run build && playwright test --project",
    "test:audio": "npm run build && playwright test --project=audio",
    "test:browser": "npm run build && playwright test --project='smoke-*' && playwright test --project=audio",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "fflate": "^0.8.3",
    "flexlayout-react": "0.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
